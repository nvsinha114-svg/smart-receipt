# Smart Receipt Backend - Environment Configuration

SERVER_PORT=8080
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/smart_receipt

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION_MS=86400000

TESSERACT_DATAPATH=./tessdata
TESSERACT_LANGUAGE=eng

# AI Parsing Configuration (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
